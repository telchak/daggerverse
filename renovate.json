{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/__fixtures__/**",
    "*/sdk/**",
    "*/clients/**"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "DAGGER_VERSION env var in CI workflow",
      "managerFilePatterns": ["/\\.github/workflows/.*\\.yml$/"],
      "matchStrings": ["DAGGER_VERSION:\\s*\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "dagger/dagger",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Dagger version badge in README",
      "managerFilePatterns": ["/(^|/)README\\.md$/"],
      "matchStrings": ["label=Dagger&message=v(?<currentValue>[^&\"\\s)]+)"],
      "depNameTemplate": "dagger/dagger",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Self-hosted runner label dagger-v* in CI workflow",
      "managerFilePatterns": ["/\\.github/workflows/.*\\.yml$/"],
      "matchStrings": ["runs-on:\\s*dagger-v(?<currentValue>\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?)"],
      "depNameTemplate": "dagger/dagger",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Dagger CLI version in the dagger-for-github snippets of the READMEs and Daggie's system prompt",
      "managerFilePatterns": ["/(^|/)README\\.md$/", "/^daggie/src/daggie/prompts/system_prompt\\.md$/"],
      "matchStrings": ["dagger/dagger-for-github@\\S+\\s+with:(?:\\s+[a-z-]+: \\S+)*?\\s+version: \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "dagger/dagger",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ],
  "packageRules": [
    {
      "description": "Dagger 1.0 betas are git tags, not GitHub releases; github-tags with semver versioning sees them",
      "matchDepNames": ["dagger/dagger"],
      "groupName": "dagger engine"
    },
    {
      "description": "uv_build version is dictated by Dagger's Python SDK template — do not update independently",
      "matchPackageNames": ["uv_build", "uv-build", "uv.build"],
      "enabled": false
    },
    {
      "description": "dagger-io and the dagger-clients-* packages are generated workspace members, regenerated by `dagger generate`",
      "matchPackageNames": ["dagger-io", "/^dagger-clients-/"],
      "enabled": false
    }
  ]
}
